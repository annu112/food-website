# =================================================================
# EMAIL (GMAIL SMTP) CONFIGURATION FOR Z KITCHEN
# =================================================================
# For Gmail, use a 16-character "App Password", not your normal password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-digit-gmail-app-password
SMTP_FROM=your-email@gmail.com


# =================================================================
# PHONE (SMS GATEWAY) CONFIGURATION FOR Z KITCHEN
# =================================================================
# Option A: TWILIO (Global SMS Gateway)
SMS_PROVIDER=TWILIO
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Option B: FAST2SMS (India SMS Gateway)
# SMS_PROVIDER=FAST2SMS
# SMS_API_KEY=your_fast2sms_api_key
